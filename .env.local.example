# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client

# OpenAI API key — used for resume extraction, rubric scoring, and brief/email generation
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1   # optional override; must support Structured Outputs (response_format: json_schema, strict)

# Resend — used to send interview-invite / rejection emails from the candidate page
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=hiring@yourdomain.com   # must be a domain verified in Resend
# Optional: no verified domain yet? Resend's sandbox mode only delivers to your
# own account email. Set this to redirect every send there (subject gets a
# "[Test — would go to ...]" tag) instead of failing. Remove once a real
# domain is verified and RESEND_FROM_ADDRESS uses it.
# RESEND_TEST_REDIRECT_EMAIL=you@yourdomain.com
